# Database
POSTGRES_PASSWORD=timeclock_dev
DATABASE_URL=postgresql://timeclock:timeclock_dev@postgres:5432/timeclock

# Supporting services
REDIS_URL=redis://redis:6379

# Authentication
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Application
CORS_ORIGIN=http://localhost:8080
API_PORT=3000
NODE_ENV=development

# Attendance location validation
MAX_GPS_ACCURACY_METERS=100
MAX_LOCATION_AGE_SECONDS=120

# ============================================================
# WORKPLACE GEOFENCE CONFIGURATION
# ============================================================
# Set these values for the organization deploying this system.
# Do not commit real organizational coordinates to a public repo.
# The actual workplace coordinates are stored in the private
# deployment database/configuration.
# ============================================================
# Replace these placeholders with the workplace coordinates and radius.
# Do not commit real organizational coordinates to the public repository.
OFFICE_LATITUDE=REPLACE_WITH_WORKPLACE_LATITUDE
OFFICE_LONGITUDE=REPLACE_WITH_WORKPLACE_LONGITUDE
OFFICE_RADIUS_METERS=100

# ============================================================
# OFFICE HOURS CONFIGURATION
# ============================================================
# Set the organization's official daily office hours here.
# Example: 08:00 to 17:00.
# These values are used by the backend to calculate attendance
# compliance. The CSV report does not need to display them.
# ============================================================
OFFICE_START_TIME=08:00
OFFICE_END_TIME=17:00
ATTENDANCE_TIMEZONE=UTC
# Monday=1 ... Sunday=7
WORKING_DAYS=1,2,3,4,5

# Development seed credentials
SEED_EMPLOYEE_PASSWORD=replace-with-a-development-password
SEED_HR_PASSWORD=replace-with-another-development-password
